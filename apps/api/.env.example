# Repository selection for the backend data layer.
DB_STRATEGY=ORM

# Runtime database URL used by the API and Prisma's pg adapter.
DATABASE_URL=postgresql://uaps:uaps@127.0.0.1:5432/uaps?schema=public&sslmode=disable

# Direct database URL used by Prisma CLI commands.
# Keep this equal to DATABASE_URL unless you add an external pooler later.
DIRECT_URL=postgresql://uaps:uaps@127.0.0.1:5432/uaps?schema=public&sslmode=disable

DATABASE_SCHEMA=public
PGPOOL_MAX=10
PGPOOL_CONNECTION_TIMEOUT_MS=5000
PGPOOL_IDLE_TIMEOUT_MS=10000

PORT=4000
API_BASE_URL=http://127.0.0.1:4000
WEB_APP_URL=http://127.0.0.1:3000
JWT_SECRET=change-this-secret-in-production
SESSION_COOKIE_NAME=uaps_session

# AI analysis configuration for the resume-builder endpoint.
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=

# GitHub OAuth settings for the existing auth flow.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:4000/v1/auth/github/callback
